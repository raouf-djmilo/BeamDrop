{
  "manifest_version": 3,
  "name": "BeamDrop - Direct P2P Device Share",
  "version": "1.6.3",
  "description": "Lightning-fast direct Device-to-Device file, photo, video, and text transfer without servers or cloud storage using WebRTC and QR codes.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel",
    "contextMenus",
    "notifications",
    "downloads",
    "alarms",
    "activeTab"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open BeamDrop Side Panel"
    },
    "quick-beam-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Quick beam clipboard content via BeamDrop"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["contentBridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://beam-drop-mu.vercel.app/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "https://*.run.app/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "updater.html",
        "updater.js",
        "folderStore.js",
        "libs/jszip.min.js",
        "libs/jsQR.min.js",
        "libs/peerjs.min.js",
        "libs/qrcode.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
function getExtQrGenerationsLeft() {
  if (isExtProUser()) return Infinity;
  const today = new Date().toISOString().slice(0, 10);
  if (extCachedDailyUsage && extCachedDailyUsage.date !== today) {
    extCachedDailyUsage.date = today;

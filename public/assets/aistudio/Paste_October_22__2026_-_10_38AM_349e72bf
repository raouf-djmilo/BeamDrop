  const today = new Date().toISOString().slice(0, 10);
  const nextCount = Number((extCachedDailyUsage && extCachedDailyUsage.qrGenerationsCount) || 0) + 1;
  extCachedDailyUsage = {
    ...(extCachedDailyUsage || {}),
